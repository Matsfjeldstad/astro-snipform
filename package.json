{
  "name": "@snipform/astro-forms",
  "version": "0.3.1",
  "description": "Typesafe Astro integration and components for SnipForm — directive-driven form backend for static sites",
  "keywords": [
    "astro",
    "astro-integration",
    "forms",
    "snipform",
    "static-sites",
    "validation"
  ],
  "homepage": "https://docs.snipform.io/forms/astro/",
  "bugs": {
    "url": "https://github.com/SnipForm/astro-forms/issues"
  },
  "license": "MIT",
  "author": "SnipForm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnipForm/astro-forms.git"
  },
  "files": [
    "dist",
    "src/client",
    "src/components",
    "src/types",
    "src/utils",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "components": [
        "./src/components/index.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./components": "./src/components/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepare": "vp config",
    "prepublishOnly": "vp check && vp test && vp pack"
  },
  "devDependencies": {
    "astro": "^7.0.6",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.0",
    "vite-plus": "0.2.2"
  },
  "peerDependencies": {
    "astro": ">=4.0.0 <8.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "packageManager": "npm@11.11.1"
}
